    "def tokenize(text):\n",
    "    return str(text).lower().split()\n",
    "\n",
    "sentences = [tokenize(t) for t in pid_overdf['clean_text'].astype(str).tolist()]\n",
    "\n",
    "w2v_size = 100\n",
    "w2v_model = Word2Vec(\n",
    "    sentences,\n",
    "    vector_size=w2v_size,\n",
    "    window=5,\n",
    "    min_count=1,  \n",
    "    workers=4,\n",
    "    sg=1 \n",
    ")\n",
    "\n",
    "w2v_model.save(\"pidgin_word2vec.model\")"
   ]
  },
