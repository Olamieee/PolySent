    "def sentence_vector(sentence, model, size):\n",
    "    tokens = tokenize(sentence)\n",
    "    vecs = []\n",
    "    for t in tokens:\n",
    "        if t in model.wv:\n",
    "            vecs.append(model.wv[t])\n",
    "    if len(vecs) == 0:\n",
    "        return np.zeros(size, dtype=np.float32)\n",
    "    return np.mean(vecs, axis=0)"
   ]
  },
