   "source": [
    "def hybrid_predict(texts, lstm_model, cnn_model, tokenizer, max_seq_length=50, label_map={0:'negative',1:'neutral',2:'positive'}, confidence_thresh=0.6):\n",
    "    results = []\n",
    "    for t in texts:\n",
    "        # Preprocess\n",
    "        t_clean = preprocess_text(t)\n",
    "        seq = tokenizer.texts_to_sequences([t_clean])\n",
    "        padded = pad_sequences(seq, maxlen=max_seq_length, padding='post', truncating='post')\n",
    "\n",
    "        # Get predictions\n",
    "        lstm_pred = lstm_model.predict(padded, verbose=0)[0]\n",
    "        cnn_pred  = cnn_model.predict(padded, verbose=0)[0]\n",
    "\n",
    "        # Average predictions\n",
    "        avg_pred = (lstm_pred + cnn_pred) / 2\n",
    "        final_idx = np.argmax(avg_pred)\n",
    "        final_label = label_map[final_idx]\n",
    "        confidence = np.max(avg_pred)\n",
    "        flag_uncertain = confidence < confidence_thresh\n",
    "\n",
    "        results.append({\n",
    "            \"text\": t,\n",
    "            \"BiLSTM\": label_map[np.argmax(lstm_pred)],\n",
    "            \"CNN\": label_map[np.argmax(cnn_pred)],\n",
    "            \"Final_Label\": final_label,\n",
    "            \"Confidence\": confidence,\n",
    "            \"Flag_Uncertain\": flag_uncertain\n",
    "        })\n",
    "    return results\n"
   ]
  },
