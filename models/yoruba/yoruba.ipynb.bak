    "    #     print(f\"  {name} -> {pred_label}\")\n",
    "\n",
    "    # DL model predictions\n",
    "    for name, dl_model in [(\"BiLSTM\", model), (\"CNN\", model2)]:\n",
    "        pred_label = dl_predict(dl_model, [text])[0]\n",
    "        print(f\"  {name} -> {pred_label}\")"
